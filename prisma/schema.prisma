// Phase 1 schema (see docs/build-spec.md §6 and §11). Every model below is
// scoped to a tenant column (organization_id at the org level, business_id
// below Business) and every one of those tables gets a matching Postgres RLS
// policy in migrations/<ts>_rls/migration.sql — app-level scoping via
// src/lib/tenant-db.ts is the primary defense, RLS is the backstop. See
// docs/build-spec.md §5 for why both layers are mandatory.
//
// This pass wires end-to-end: Organization/User/OrgMembership, Business,
// Product. Everything else below (Icp/ScoringConfig/Lead*/Deal/AiInstruction/
// KnowledgeSource/Subscription/AiUsageLog/AuditLog/AiCreditWallet) is schema
// only for now — modeled up front so later phases are additive migrations,
// not schema surgery — with CRUD/UI landing in following passes per the
// Phase 1 item list in docs/build-spec.md §11.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL for migrate/introspect comes from prisma7.config.ts (Prisma 7
// moved it out of the schema file). PrismaClient at runtime still needs its own
// url/adapter wiring wherever it's constructed — see src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum OrgRole {
  owner
  admin
  manager
  sales
  marketing
  viewer
}

enum IcpSource {
  manual
  ai_discovered
}

enum LeadChannel {
  manual
  csv
  webhook
  whatsapp
  facebook
  instagram
  email
  google
  tiktok
  linkedin
  referral
  api
  news
  youtube
  etsy
  osm
  registry
}

// How a lead arrived, independent of the channel it came through: "organic"
// is everything not paid-for (prospecting, inbound DMs/comments, forms,
// referrals); "paid" is injected from an ad (Lead Ads, ad-platform leads).
// Lets Insights compare organic vs paid per channel without Zeroid managing
// any ad account.
enum LeadMedium {
  organic
  paid
}

enum LeadStage {
  new
  contacted
  engaged
  qualified
  hot
  appointment
  proposal
  negotiation
  won
  lost
  nurture
}

enum AiInstructionStatus {
  active
  inactive
}

enum KnowledgeType {
  text
  pdf
  url
  doc
}

enum KnowledgeStatus {
  pending
  processing
  ready
  failed
}

enum SubscriptionPlan {
  solo
  pro
  team
  business
  enterprise
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum PaymentProvider {
  stripe
  flutterwave
}

enum TaskStatus {
  open
  done
}

enum AppointmentStatus {
  scheduled
  completed
  canceled
  no_show
}

enum ReferralStatus {
  pending
  converted
  declined
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships     OrgMembership[]
  businesses      Business[]
  subscription    Subscription?
  creditWallet    AiCreditWallet?
  creditPurchases CreditPurchase[]
  auditLogs       AuditLog[]
  invites         Invite[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  memberships OrgMembership[]
  auditLogs   AuditLog[]
}

// A user's role within one organization. A user can belong to more than one
// organization (e.g. an agency operator running client accounts) — role is
// per-membership, never global.
model OrgMembership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(owner)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum InviteStatus {
  pending
  accepted
  revoked
}

// No email service is configured yet (build-spec §14 cost discipline — no
// new provider without a reason), so an invite is a link the owner/admin
// shares manually rather than something the app emails. token is the only
// thing that gates acceptance — see /invite/[token].
model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole      @default(sales)
  token          String       @unique @default(cuid())
  status         InviteStatus @default(pending)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Business {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id])
  products           Product[]
  icpProfiles        IcpProfile[]
  scoringConfig      ScoringConfig?
  leadSources        LeadSource[]
  leads              Lead[]
  deals              Deal[]
  instructions       AiInstruction[]
  knowledge          KnowledgeSource[]
  aiUsageLogs        AiUsageLog[]
  tasks              Task[]
  appointments       Appointment[]
  referrals          Referral[]
  contentItems       ContentItem[]
  prospects          Prospect[]
  discoveryJobs      DiscoveryJob[]
  discoveryCells     DiscoveryCell[]
  prospectEmails     ProspectEmail[]
  whatsappConnection WhatsAppConnection?
  intakeKey          IntakeKey?
  sendingIdentities  SendingIdentity[]
  segments           Segment[]
  campaigns          Campaign[]
  sequences          Sequence[]
  sequenceSteps      SequenceStep[]
  campaignMessages   CampaignMessage[]
  suppressions       Suppression[]
  emailEvents        EmailEvent[]
  metaConnection     MetaConnection?

  @@index([organizationId])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model IcpProfile {
  id         String    @id @default(cuid())
  businessId String
  name       String
  attributes Json
  source     IcpSource @default(manual)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

// One row per business — weights for the lead-scoring formula (build-spec §6
// alteration: configurable per business, not a global constant).
model ScoringConfig {
  id         String   @id @default(cuid())
  businessId String   @unique
  weights    Json // { icpFit, problemSeverity, purchaseIntent, budgetFit, urgency, engagement, decisionAuthority }
  hotAt      Int      @default(80)
  warmAt     Int      @default(60)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model LeadSource {
  id         String      @id @default(cuid())
  businessId String
  channel    LeadChannel
  name       String
  createdAt  DateTime    @default(now())

  business Business @relation(fields: [businessId], references: [id])
  leads    Lead[]

  @@index([businessId])
}

enum ProspectStatus {
  new
  imported
  dismissed
}

// A candidate lead surfaced by an external prospecting source (Google
// Places first; more sources land as additional `channel` values reuse the
// same enum Lead/LeadSource already use). Kept separate from Lead until a
// human reviews and imports it — same "AI Suggest, human executes" pattern
// as everything else in this app. `externalId` is the source's own id
// (Google's place id) so re-running the same search doesn't create
// duplicates for this business.
model Prospect {
  id         String         @id @default(cuid())
  businessId String
  channel    LeadChannel
  externalId String
  name       String
  address    String?
  phone      String?
  email      String?
  website    String?
  category   String?
  sourceUrl  String?
  status     ProspectStatus @default(new)
  createdAt  DateTime       @default(now())
  leadId     String?        @unique

  // Phase 2 discovery + enrichment. `domain` is the registrable host of `website` (www stripped)
  // and is the main de-duplication key; `signals` holds what the crawl saw (title, description,
  // tech, people, phones, social links, pages read, extra sources) and is never trusted as input.
  domain              String?
  country             String?
  lat                 Float?
  lon                 Float?
  discoveryJobId      String?
  enrichStatus        String    @default("none") // none | pending | running | done | failed | skipped
  enrichAttempts      Int       @default(0)
  enrichStartedAt     DateTime?
  enrichedAt          DateTime?
  enrichError         String?
  researchNote        String?
  signals             Json      @default("{}")
  bestEmailConfidence Int?

  business Business        @relation(fields: [businessId], references: [id])
  lead     Lead?           @relation(fields: [leadId], references: [id])
  emails   ProspectEmail[]

  @@unique([businessId, channel, externalId])
  @@index([businessId])
  @@index([businessId, domain])
  @@index([enrichStatus, businessId])
}

// One discovery run: industries x locations, cut into grid cells that are worked off in the
// background. The caps (maxProspects, maxCells) exist so a typo cannot start an unbounded crawl.
model DiscoveryJob {
  id             String    @id @default(cuid())
  businessId     String
  organizationId String
  name           String
  status         String    @default("planning") // planning | running | paused | done | failed | cancelled
  industries     Json      @default("[]")
  locations      Json      @default("[]")
  sources        Json      @default("[]")
  maxProspects   Int       @default(300)
  maxCells       Int       @default(200)
  autoEnrich     Boolean   @default(true)
  cellsTotal     Int       @default(0)
  cellsDone      Int       @default(0)
  found          Int       @default(0)
  duplicates     Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  business Business        @relation(fields: [businessId], references: [id])
  cells    DiscoveryCell[]

  @@index([businessId, status])
}

// The queue: one row per (industry, grid square, source). Claimed with FOR UPDATE SKIP LOCKED.
model DiscoveryCell {
  id            String    @id @default(cuid())
  businessId    String
  jobId         String
  industry      String
  locationLabel String
  source        String
  south         Float
  west          Float
  north         Float
  east          Float
  status        String    @default("pending") // pending | running | done | failed
  attempts      Int       @default(0)
  found         Int       @default(0)
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  business Business     @relation(fields: [businessId], references: [id])
  job      DiscoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([status, source])
}

// Every address we found or derived for a prospect, with how sure we are and why. Only addresses
// at or above the business threshold are ever copied onto a lead.
model ProspectEmail {
  id         String   @id @default(cuid())
  businessId String
  prospectId String
  email      String
  kind       String // found | role | pattern_guess
  source     String // page URL, "osm", "jsonld", "pattern:first.last", ...
  personName String?
  mxOk       Boolean?
  catchAll   Boolean?
  smtp       String   @default("unchecked") // unchecked | accepted | rejected | unknown
  confidence Int      @default(0)
  reasons    Json     @default("[]")
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([prospectId, email])
  @@index([businessId, confidence])
}

// One real Meta WhatsApp Business number per business, talked to directly
// via the Graph API -- not through ../platform-services' channels service,
// which turned out to be hardcoded to Skynett's own orchestrator for every
// resolve/reply call (see platform-services-project memory, 2026-09-18).
// accessToken is a long-lived system-user token from the WABA this number
// lives under. The webhook has no business/session context until it looks
// this row up by phoneNumberId, hence the RLS self-lookup policy (same
// pattern as Invite's token lookup). organizationId is denormalized here
// (not just businessId) for the same reason LeadEvent denormalizes
// businessId -- Business's own RLS policy needs app.organization_id set,
// which the webhook doesn't have until this lookup returns it.
model WhatsAppConnection {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  organizationId     String
  phoneNumberId      String   @unique
  wabaId             String
  displayPhoneNumber String?
  accessToken        String
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

// Public, write-only key for a business's lead-capture form / API. It can only
// CREATE leads, so it is safe to embed in a web page (like a form ID). The
// intake endpoint has no session, so it resolves the business from this row --
// hence the app.intake_key RLS self-lookup (same shape as Invite/WhatsApp).
model IntakeKey {
  id             String   @id @default(cuid())
  businessId     String   @unique
  organizationId String
  publicKey      String   @unique
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

// One Facebook Page (and optionally its linked Instagram professional
// account) per business, talked to directly via the Graph API with a Page
// access token. The Meta webhook only carries the page/IG account id, so it
// resolves the business through the app.meta_account_id RLS self-lookup.
model MetaConnection {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  organizationId     String
  pageId             String   @unique
  pageName           String?
  instagramAccountId String?  @unique
  pageAccessToken    String
  subscribed         Boolean  @default(false)
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
}

// Qualification factors (icpScore + the six below) can be entered manually
// by a rep, or populated by the AI qualification conversation over
// WhatsApp (src/app/api/webhooks/whatsapp/route.ts). Each is
// 0-100 ("how strong is this factor"), and leadScore is the weighted average
// per ScoringConfig.weights (see src/lib/scoring.ts). When the AI
// qualification engine lands later, it fills these same fields instead of a
// human — the CRM/scoring code downstream doesn't need to change.
model Lead {
  id               String     @id @default(cuid())
  businessId       String
  sourceId         String?
  name             String?
  email            String?
  phone            String?
  company          String?
  contact          Json       @default("{}")
  stage            LeadStage  @default(new)
  medium           LeadMedium @default(organic)
  campaign         String?
  assignedToUserId String?

  icpScore          Int?
  problemSeverity   Int?
  purchaseIntent    Int?
  budgetFit         Int?
  urgency           Int?
  engagement        Int?
  decisionAuthority Int?
  leadScore         Int?

  // Set when the lead came from discovery: how sure we are the email works, and a factual research note.
  emailConfidence Int?
  researchNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id])
  source           LeadSource?       @relation(fields: [sourceId], references: [id])
  events           LeadEvent[]
  deals            Deal[]
  tasks            Task[]
  appointments     Appointment[]
  referrals        Referral[]        @relation("ReferrerLead")
  prospect         Prospect?
  campaignMessages CampaignMessage[]

  @@index([businessId])
  @@index([businessId, stage])
}

// Denormalized businessId (not just leadId) so the RLS policy doesn't need a
// join — see docs/build-spec.md §6 note on LeadEvent.
model LeadEvent {
  id         String   @id @default(cuid())
  businessId String
  leadId     String
  type       String
  payload    Json     @default("{}")
  createdAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([businessId])
  @@index([leadId, createdAt])
}

model Deal {
  id         String    @id @default(cuid())
  businessId String
  leadId     String
  value      Decimal?  @db.Decimal(12, 2)
  currency   String    @default("USD")
  wonAt      DateTime?
  lostAt     DateTime?
  createdAt  DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@index([businessId])
}

// Generic task — doubles as the human-handover mechanism (build-spec §11
// item 12 / vision doc §27): a lead reaching "hot" auto-creates one of these
// rather than a separate Handover model, since a handover *is* "something a
// human needs to do about this lead."
model Task {
  id               String     @id @default(cuid())
  businessId       String
  leadId           String?
  title            String
  note             String?
  status           TaskStatus @default(open)
  assignedToUserId String?
  dueAt            DateTime?
  createdAt        DateTime   @default(now())

  business Business @relation(fields: [businessId], references: [id])
  lead     Lead?    @relation(fields: [leadId], references: [id])

  @@index([businessId, status])
  @@index([leadId])
}

// Phase 2 (build-spec §12 / vision doc §30). Manual/internal only for now —
// no Google Calendar sync yet (needs real OAuth credentials this account
// doesn't have configured), so this is booked and tracked inside Zeroid,
// not pushed to an external calendar. externalCalendarEventId is reserved
// for when that integration lands, so this doesn't need a schema change then.
model Appointment {
  id                      String            @id @default(cuid())
  businessId              String
  leadId                  String
  startAt                 DateTime
  status                  AppointmentStatus @default(scheduled)
  notes                   String?
  externalCalendarEventId String?
  createdAt               DateTime          @default(now())

  business Business @relation(fields: [businessId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@index([businessId, startAt])
}

// Phase 2 (build-spec §12 / vision doc §31). referrerLeadId is the existing
// lead/customer making the referral; the referral itself becomes a new Lead
// (via LeadChannel.referral) once/if they actually reach out — this row
// just tracks the ask and its outcome.
model Referral {
  id              String         @id @default(cuid())
  businessId      String
  referrerLeadId  String
  referredName    String
  referredContact String?
  status          ReferralStatus @default(pending)
  createdAt       DateTime       @default(now())

  business     Business @relation(fields: [businessId], references: [id])
  referrerLead Lead     @relation("ReferrerLead", fields: [referrerLeadId], references: [id])

  @@index([businessId])
}

enum ContentPurpose {
  awareness
  problem_identification
  education
  authority
  trust
  objection_handling
  lead_capture
  conversion
}

enum ContentStatus {
  draft
  approved
  published
}

// Organic content engine (build-spec §12 / vision doc §16-17), scoped down
// to what's honestly buildable without a licensed-scraping/social-posting
// integration: AI drafts content tied to a purpose and the business's ICP,
// a human reviews/edits and publishes it themselves (build-spec §37 "AI
// Suggest" tier — same pattern as the follow-up drafter). No auto-posting to
// any platform.
model ContentItem {
  id         String         @id @default(cuid())
  businessId String
  purpose    ContentPurpose
  channel    String // e.g. "linkedin", "email", "whatsapp_broadcast" — free text for now, no platform integration to validate against
  prompt     String // what was asked for, kept for regeneration/audit
  content    String
  status     ContentStatus  @default(draft)
  createdAt  DateTime       @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
}

model AiInstruction {
  id         String              @id @default(cuid())
  businessId String
  name       String
  content    String
  priority   Int                 @default(0)
  status     AiInstructionStatus @default(active)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

// Metadata/status only — chunking, embedding, and retrieval happen in
// ../platform-services' Knowledge service, not here. See build-spec §11 item 4.
model KnowledgeSource {
  id         String          @id @default(cuid())
  businessId String
  type       KnowledgeType
  title      String
  status     KnowledgeStatus @default(pending)
  createdAt  DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  plan                   SubscriptionPlan   @default(solo)
  status                 SubscriptionStatus @default(trialing)
  provider               PaymentProvider    @default(flutterwave)
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

// Separate credit wallet per organization, shared across its businesses —
// see build-spec §9. Balance changes happen only through withMetering() once
// the AI abstraction layer lands; this pass just seeds the row on signup.
model AiCreditWallet {
  id             String   @id @default(cuid())
  organizationId String   @unique
  balance        Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

enum CreditPurchaseStatus {
  pending
  completed
  failed
}

// One row per attempted credit purchase — txRef is unique so a repeated
// verify call (e.g. the owner double-clicking "I've paid" or Flutterwave's
// redirect firing twice) can never credit the wallet more than once for the
// same transaction. See build-spec §9/§15 — this is the audit trail credit
// metering was missing before there was any way to actually buy credits.
model CreditPurchase {
  id             String               @id @default(cuid())
  organizationId String
  txRef          String               @unique
  amountUsd      Decimal              @db.Decimal(10, 2)
  credits        Int
  status         CreditPurchaseStatus @default(pending)
  createdAt      DateTime             @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// Ledger of actual AI provider calls — see build-spec §7 withMetering().
model AiUsageLog {
  id             String   @id @default(cuid())
  businessId     String
  task           String
  model          String
  tokensIn       Int
  tokensOut      Int
  creditsCharged Int
  createdAt      DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  target         String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// B2B email campaigns. Mirrors Skynett Business -> Campaign -> Segment ->
// Sequence -> Messages structure. Every table carries businessId and the same
// RLS pattern as the rest of the schema; CampaignMessage additionally has
// narrow self-lookups (by token / Message-ID) because the unsubscribe page,
// tracking pixel and inbound-mail endpoint have no session.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  draft
  active
  paused
  completed
}

enum IdentityProvider {
  brevo_shared // the shared Brevo account (Flux9, Moneyvarsity...) -- SANDBOX ONLY, enforced in code
  smtp // our own MTA or any SMTP relay, DKIM-signed by the app
}

enum MessageStatus {
  scheduled
  sending
  sent
  bounced
  failed
  skipped // suppressed / blocked by a safeguard / invalid address
  cancelled // reply, unsubscribe or campaign stopped before this step went out
}

enum EmailEventType {
  sent
  delivered
  bounced
  opened
  clicked
  replied
  unsubscribed
  complained
  blocked
}

enum SuppressionReason {
  unsubscribe
  hard_bounce
  complaint
  manual
  global_optout
}

model SendingIdentity {
  id                 String           @id @default(cuid())
  businessId         String
  name               String
  provider           IdentityProvider @default(brevo_shared)
  fromEmail          String
  fromName           String
  replyToEmail       String?
  // CAN-SPAM / GDPR-style requirement: every email carries a physical postal address.
  physicalAddress    String
  smtpHost           String?
  smtpPort           Int?
  smtpSecure         Boolean          @default(false)
  smtpUser           String?
  smtpPass           String?
  dkimDomain         String?
  dkimSelector       String?
  dkimPrivateKey     String?
  // Mailbox we READ replies and bounces from (IMAP). Optional; works with any provider.
  imapHost           String?
  imapPort           Int?
  imapSecure         Boolean          @default(true)
  imapUser           String?
  imapPass           String?
  imapFolder         String           @default("INBOX")
  imapLastCheckAt    DateTime?
  // Highest message UID already processed, so each message is looked at exactly once (mailbox is read-only to us).
  imapLastUid        Int?
  imapLastError      String?
  dailyCap           Int              @default(20)
  perDomainHourlyCap Int              @default(5)
  warmupStartedAt    DateTime?
  // New identities are sandbox-only until an owner deliberately turns it off, and
  // a brevo_shared identity can never leave sandbox (see src/lib/email-campaigns/guard.ts).
  sandboxOnly        Boolean          @default(true)
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())

  business  Business   @relation(fields: [businessId], references: [id])
  campaigns Campaign[]

  @@index([businessId])
}

model Segment {
  id         String   @id @default(cuid())
  businessId String
  name       String
  // Saved filter over leads: { channels?, stages?, medium?, minScore?, maxScore?, createdAfter?, createdBefore? ... }
  filter     Json     @default("{}")
  createdAt  DateTime @default(now())

  business  Business   @relation(fields: [businessId], references: [id])
  campaigns Campaign[]

  @@index([businessId])
}

model Campaign {
  id             String         @id @default(cuid())
  businessId     String
  // Denormalised so session-less code (inbound replies) can bill AI work to the right wallet.
  organizationId String
  name           String
  objective      String?
  status         CampaignStatus @default(draft)
  segmentId      String
  identityId     String
  // Recipients are emailed inside this window (campaign timezone, or the lead own if known).
  timezone       String         @default("UTC")
  sendStartHour  Int            @default(9)
  sendEndHour    Int            @default(17)
  weekdaysOnly   Boolean        @default(true)
  startedAt      DateTime?
  createdAt      DateTime       @default(now())

  business Business          @relation(fields: [businessId], references: [id])
  segment  Segment           @relation(fields: [segmentId], references: [id])
  identity SendingIdentity   @relation(fields: [identityId], references: [id])
  sequence Sequence?
  messages CampaignMessage[]

  @@index([businessId, status])
}

model Sequence {
  id         String   @id @default(cuid())
  businessId String
  campaignId String   @unique
  name       String
  createdAt  DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id])
  campaign Campaign       @relation(fields: [campaignId], references: [id])
  steps    SequenceStep[]
}

model SequenceStep {
  id            String  @id @default(cuid())
  businessId    String
  sequenceId    String
  position      Int
  // Days to wait after the previous step was sent (0 for the first step).
  delayDays     Int     @default(0)
  subject       String
  // Optional second subject line: A/B split, decided per lead and recorded on the message.
  subjectB      String?
  // Plain-text template with {{firstName}}, {{company}}, {{senderName}} placeholders.
  body          String
  aiPersonalise Boolean @default(false)

  business Business          @relation(fields: [businessId], references: [id])
  sequence Sequence          @relation(fields: [sequenceId], references: [id])
  messages CampaignMessage[]

  @@unique([sequenceId, position])
}

model CampaignMessage {
  id           String        @id @default(cuid())
  businessId   String
  campaignId   String
  leadId       String
  stepId       String
  toEmail      String
  // "A" or "B" when the step has an A/B subject test.
  variant      String?
  // Unguessable per-message token used in the unsubscribe link, tracking pixel and reply address.
  token        String        @unique
  status       MessageStatus @default(scheduled)
  scheduledFor DateTime
  sentAt       DateTime?
  // The SMTP Message-ID we sent with, used to match replies and bounces back to this row.
  messageId    String?       @unique
  subject      String?
  bodyHtml     String?
  error        String?
  attempts     Int           @default(0)
  createdAt    DateTime      @default(now())

  business Business     @relation(fields: [businessId], references: [id])
  campaign Campaign     @relation(fields: [campaignId], references: [id])
  lead     Lead         @relation(fields: [leadId], references: [id])
  step     SequenceStep @relation(fields: [stepId], references: [id])
  events   EmailEvent[]

  @@unique([campaignId, leadId, stepId])
  @@index([businessId, status, scheduledFor])
}

// businessId NULL = platform-wide (hard bounces, complaints, never-email-me-from-any-Zeroid-sender).
model Suppression {
  id         String            @id @default(cuid())
  businessId String?
  email      String
  reason     SuppressionReason
  source     String?
  createdAt  DateTime          @default(now())

  business Business? @relation(fields: [businessId], references: [id])

  @@index([email])
}

model EmailEvent {
  id         String         @id @default(cuid())
  businessId String
  campaignId String
  messageId  String
  leadId     String
  type       EmailEventType
  payload    Json           @default("{}")
  createdAt  DateTime       @default(now())

  business Business        @relation(fields: [businessId], references: [id])
  message  CampaignMessage @relation(fields: [messageId], references: [id])

  @@index([businessId, campaignId, type])
  @@index([messageId])
}
