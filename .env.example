# Copy to .env.local and fill in. Never commit .env.local.
# DATABASE_URL lives in .env (Prisma 7's config loader reads .env, not
# .env.local — see prisma7.config.ts). Copy this block there too for local dev.

DATABASE_URL="postgresql://zeroid_dev:zeroid_dev_local_only@localhost:5432/zeroid_dev"

ANTHROPIC_API_KEY=

BREVO_API_KEY=
# No verified sender identity for Zeroid yet — see build-spec.md §14/README.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Zeroid

# This account's Flutterwave credentials are shared across Mongozutu, Flux9,
# and Zeroid (same merchant account) — rotating requires updating all three.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ../platform-services' knowledge/RAG service, reached through an
# authenticated nginx path on wa.lagosbusinessgroup.com (borrowed domain,
# see platform-services/docs/build-spec.md and the platform-services-project
# memory) -- NOT the raw Docker host port, which has no auth of its own.
# PLATFORM_KNOWLEDGE_BASE_URL defaults to that path if unset.
PLATFORM_KNOWLEDGE_BASE_URL=
PLATFORM_KNOWLEDGE_API_KEY=

# Prospecting -- Places API (New), Text Search. Needs a Google Cloud
# project with billing enabled (Google gives ~$200/mo free credit, which
# should cover this at MVP volume) and the Places API enabled on it.
GOOGLE_PLACES_API_KEY=
